# Payroll Management System - Environment Configuration
# Copy this file to .env and adjust values for your environment
# DO NOT commit .env to version control

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_DB=payroll_db
POSTGRES_USER=payroll_user
POSTGRES_PASSWORD=payroll_pass
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=C --lc-ctype=C
POSTGRES_TIMEZONE=Asia/Dhaka

# JDBC Connection String
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/payroll_db
SPRING_DATASOURCE_USERNAME=payroll_user
SPRING_DATASOURCE_PASSWORD=payroll_pass

# ==========================================
# SPRING BOOT CONFIGURATION
# ==========================================
# Valid profiles: docker, test, ci, debug
SPRING_PROFILES_ACTIVE=docker
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# ==========================================
# JWT & SECURITY
# ==========================================
JWT_SECRET=DockerSecretKeyForPayrollSystemProduction2024

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_ORG_SP_PAYROLL_SERVICE=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=WARN
LOGGING_PATTERN_CONSOLE=%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n

# ==========================================
# JVM CONFIGURATION
# ==========================================
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom
GRADLE_OPTS=-Dorg.gradle.parallel=true -Dorg.gradle.workers.max=4

# ==========================================
# DOCKER CONFIGURATION
# ==========================================
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=payroll-service
DOCKER_IMAGE_TAG=latest

# ==========================================
# JENKINS CONFIGURATION (jenkins/docker-compose.yml)
# ==========================================
JENKINS_JAVA_OPTS=-Xmx2g -Xms1g
JENKINS_OPTS=--prefix=/jenkins

# ==========================================
# DATABASE UI ACCESS (PgAdmin - Development only)
# ==========================================
PGADMIN_DEFAULT_EMAIL=admin@payroll.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ==========================================
# PORT MAPPINGS
# ==========================================
PAYROLL_SERVICE_PORT=20001
POSTGRES_PORT=5432
PGADMIN_PORT=5050
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000

# ==========================================
# REDIS CONFIGURATION (Optional)
# ==========================================
# REDIS_HOST=redis
# REDIS_PORT=6379
# SPRING_REDIS_HOST=redis
# SPRING_REDIS_PORT=6379
